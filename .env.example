# Para onde vão os formulários: /api/pedido/ (email para EMAIL_PEDIDOS) ou a rota do CRM
# (ex.: https://crm.mlseguros.pt/api/site/pedido). Sem ele, abrem o email do visitante já preenchido.
PUBLIC_FORM_ENDPOINT=/api/pedido/
# Endereço do CRM, para a "Área de cliente" (ex.: https://crm.mlseguros.pt). Sem ele, não há área de cliente.
PUBLIC_CRM_URL=
# Medição própria (páginas, tempo, scroll, cliques) para o Marketing do CRM, em todas as visitas (sem cookies, anónima, se a Estatística for recusada).
# Ex.: https://crm.mlseguros.pt/api/site/medicao. Sem ele, não mede.
PUBLIC_MEDICAO_URL=
# Chave partilhada com o CRM para o registo dos robôs que leem o site (middleware.js). Só no servidor.
ROBOS_CHAVE=

# Pedidos por email (api/pedido.js). Envio numa camada trocável (api/_lib/email.js).
EMAIL_PEDIDOS=geral@mlseguros.pt
EMAIL_REMETENTE=Site ML Seguros <pedidos@site.mlseguros.pt>
# resend (produção) ou mailpit (local, com MAILPIT_URL=http://127.0.0.1:54324)
EMAIL_FORNECEDOR=resend
RESEND_API_KEY=
# true quando o site estiver no domínio da ML: tira o noindex e põe o canonical.
PUBLIC_PUBLICADO=
# Google Tag Manager (GA4, Google Ads), com o banner de cookies e o Consent Mode v2. Sem ele, não há banner nem medição.
PUBLIC_GTM_ID=GTM-MSFNHBZX

# Avaliações do Google (api/avaliacoes.js). Chave da Google Places API (New), em nome da ML,
# restrita a esta API. Sem ela, a secção mostra só a ligação para as avaliações no Google.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=ChIJk4sSUXQnHw0Rx610-IWEwb4
AVALIACOES_FORNECEDOR=google-places
