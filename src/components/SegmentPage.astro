---
import Photo from './Photo.astro';
import PageHero from './PageHero.astro';
import CtaBand from './CtaBand.astro';
import { ramosBySegment } from '../data/site.js';

interface Props {
  segment: 'particulares' | 'empresas';
  title: string;
  lead: string;
  crumb: string;
  introTitle: string;
  introImage: string;
  introAlt: string;
}
const { segment, title, lead, crumb, introTitle, introImage, introAlt } = Astro.props;
const items = ramosBySegment(segment);
---
<PageHero title={title} lead={lead} crumbs={[{ label: crumb }]} />

<section class="section">
  <div class="container">
    <ul class="ramo-list">
      {items.map((r) => (
        <li>
          <h3><a href={`/seguros/${r.slug}/`}>{r.name}</a></h3>
          <p>{r.short}</p>
          <a class="more" href={`/seguros/${r.slug}/`}>Coberturas e perguntas frequentes</a>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="section section--alt">
  <div class="container feature">
    <Photo name={introImage} alt={introAlt} sizes="(max-width: 860px) 100vw, 540px" />
    <div>
      <h2>{introTitle}</h2>
      <slot name="intro" />
    </div>
  </div>
</section>

<slot />

<CtaBand />
