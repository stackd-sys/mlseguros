---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { company, ramosBySegment } from '../data/site.js';

const path = Astro.url.pathname;
const groups = [
  { label: 'Particulares', href: '/seguros-particulares/', items: ramosBySegment('particulares') },
  { label: 'Empresas', href: '/seguros-empresas/', items: ramosBySegment('empresas') },
];
const links = [
  { label: 'Sinistros', href: '/sinistros/' },
  { label: 'Sobre nós', href: '/sobre-nos/' },
  { label: 'Contactos', href: '/contactos/' },
];
---
<div class="topbar">
  <div class="container">
    <ul>
      <li><a href={company.mapsHref} target="_blank" rel="noopener">{company.address.street}, {company.address.locality}</a></li>
      <li class="hide-md"><a href={`mailto:${company.email}`}>{company.email}</a></li>
    </ul>
    <ul>
      <li class="hide-md">Registo ASF n.º {company.asf}</li>
      <li><a href={company.phoneHref}>{company.phone}</a></li>
    </ul>
  </div>
</div>

<header class="header">
  <div class="container">
    <Logo />
    <nav class="nav" id="nav" aria-label="Principal">
      <ul>
        {groups.map((g) => (
          <li class="nav__item">
            <button class="nav__link" type="button" aria-expanded="false" aria-current={path.startsWith(g.href) ? 'page' : undefined}>
              {g.label} <Icon name="chevron" size={14} />
            </button>
            <ul class="nav__drop">
              {g.items.map((r) => (
                <li><a href={`/seguros/${r.slug}/`}>{r.name}</a></li>
              ))}
              <li><a class="all" href={g.href}>Todos os seguros para {g.label.toLowerCase()}</a></li>
            </ul>
          </li>
        ))}
        {links.map((l) => (
          <li><a class="nav__link" href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
      <button type="button" class="btn btn--outline nav__cta client-btn" aria-disabled="true" title="Área de Cliente (brevemente)">Área de Cliente</button>
      <a class="btn nav__cta" href="/simulacao/">Pedir simulação</a>
    </nav>
    <div class="header__actions">
      <button type="button" class="btn btn--outline btn--sm client-btn" aria-disabled="true" title="Área de Cliente (brevemente)">Área de Cliente</button>
      <a class="btn btn--sm" href="/simulacao/">Pedir simulação</a>
      <button class="burger" type="button" aria-controls="nav" aria-expanded="false" aria-label="Abrir menu">
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>
</header>

<script>
  const burger = document.querySelector<HTMLButtonElement>('.burger');
  const nav = document.getElementById('nav');
  burger?.addEventListener('click', () => {
    const open = nav!.classList.toggle('is-open');
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
    document.body.style.overflow = open ? 'hidden' : '';
  });
  document.querySelectorAll<HTMLButtonElement>('.nav__item > .nav__link').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.parentElement!;
      const open = item.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', String(open));
    });
  });
</script>
