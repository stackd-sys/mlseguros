---
import PageHero from './PageHero.astro';
interface Props { title: string; lead?: string; foto?: string }
const { title, lead, foto = 'sobre3' } = Astro.props;
---
<PageHero titulo={title} foto={foto} lead={lead} migalhas={[{ nome: title }]} />
<section class="sec">
  <div class="wrap">
    <div class="texto"><slot /></div>
  </div>
</section>
