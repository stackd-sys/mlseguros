---
interface Props { perguntas: [string, string][]; nome?: string; escuro?: boolean; numerar?: boolean }
const { perguntas, nome = 'faq', escuro = false, numerar = false } = Astro.props;
---
<div class={escuro ? 'acc acc--dark' : 'acc'}>
  {perguntas.map(([q, a], i) => (
    <details name={nome} open={i === 0}>
      <summary>{numerar ? `${i + 1}. ${q}` : q}<span class="acc__sinal" aria-hidden="true"></span></summary>
      <div class="acc__body"><div><p>{a}</p></div></div>
    </details>
  ))}
</div>
