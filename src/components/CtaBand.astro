---
// Faixa de contacto no fim das páginas.
import { company } from '../data/site.js';
interface Props { title?: string; tipo?: string }
const { title = 'Quer rever os seus seguros connosco?', tipo } = Astro.props;
---
<section class="contact-strip">
  <div class="container">
    <div>
      <h2>{title}</h2>
      <p>Ligue para o <a class="link" href={company.phoneHref}>{company.phone}</a> <span class="muted small">({company.phoneNote.toLowerCase()})</span>, escreva para <a class="link" href={`mailto:${company.email}`}>{company.email}</a> ou passe no escritório, na {company.address.street}, Ericeira.</p>
    </div>
    <a class="btn" href={tipo ? `/simulacao/?tipo=${tipo}` : '/simulacao/'}>Pedir simulação</a>
  </div>
</section>
