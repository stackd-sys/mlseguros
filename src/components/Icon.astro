---
// Ícones Lucide (ISC) e Simple Icons (CC0), lidos dos pacotes no momento do build.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

interface Props { name: string; class?: string; label?: string }
const { name, class: cls = 'icon', label } = Astro.props;

const MARCAS: Record<string, string> = { whatsapp: 'whatsapp', instagram: 'instagram', facebook: 'facebook' };
const LINKEDIN = '<path d="M4.98 3.5c0 1.38-1.11 2.5-2.48 2.5S.02 4.88.02 3.5 1.13 1 2.5 1s2.48 1.12 2.48 2.5zM.5 8h4v16h-4V8zm7.5 0h3.83v2.19h.06c.53-1.01 1.84-2.07 3.8-2.07C19.73 8.12 20.5 10.8 20.5 14.3V24h-4v-8.6c0-2.05-.04-4.69-2.86-4.69-2.86 0-3.3 2.23-3.3 4.54V24H8V8z"/>';

let interior = '';
let attrs = '';
if (name === 'linkedin') {
  interior = LINKEDIN;
  attrs = 'viewBox="0 0 24 24" fill="currentColor"';
} else if (MARCAS[name]) {
  const svg = readFileSync(join(process.cwd(), 'node_modules/simple-icons/icons', `${MARCAS[name]}.svg`), 'utf8');
  interior = svg.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '').replace(/<title>[\s\S]*?<\/title>/, '');
  attrs = 'viewBox="0 0 24 24" fill="currentColor"';
} else {
  const svg = readFileSync(join(process.cwd(), 'node_modules/lucide-static/icons', `${name}.svg`), 'utf8');
  interior = svg.replace(/^[\s\S]*?<svg[\s\S]*?>/, '').replace(/<\/svg>\s*$/, '').trim();
  attrs = 'viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"';
}
const a11y = label ? `role="img" aria-label="${label}"` : 'aria-hidden="true" focusable="false"';
---
<Fragment set:html={`<svg class="${cls}" xmlns="http://www.w3.org/2000/svg" ${attrs} ${a11y}>${interior}</svg>`} />
