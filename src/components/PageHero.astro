---
// Cabeçalho simples das páginas interiores: caminho, título e uma frase.
interface Props { title: string; lead?: string; crumbs?: { label: string; href?: string }[] }
const { title, lead, crumbs = [] } = Astro.props;
---
<section class="page-head">
  <div class="container">
    <nav aria-label="Caminho">
      <ol class="crumbs">
        <li><a href="/">Início</a></li>
        {crumbs.map((c) => c.href ? <li><a href={c.href}>{c.label}</a></li> : <li aria-current="page">{c.label}</li>)}
      </ol>
    </nav>
    <h1>{title}</h1>
    {lead && <p>{lead}</p>}
    <slot />
  </div>
</section>
