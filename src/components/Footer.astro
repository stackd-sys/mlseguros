---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import Formulario from './Formulario.astro';
import { company, ramos } from '../data/site.js';
import { guiasVisiveis } from '../data/guias';

const links = [
  { nome: 'Início', href: '/' },
  { nome: 'Particulares', href: '/seguros-particulares/' },
  { nome: 'Empresas', href: '/seguros-empresas/' },
  { nome: 'Sinistros', href: '/sinistros/' },
  { nome: 'Simulação', href: '/simulacao/' },
  ...((await guiasVisiveis()).length ? [{ nome: 'Guias', href: '/guias/' }] : []),
  { nome: 'Sobre nós', href: '/sobre-nos/' },
  { nome: 'Contactos', href: '/contactos/' },
];
const ano = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap">
    <div class="footer__cols">
      <div class="footer__contacto">
        <h2>Contactos</h2>
        <p>{company.address.street}<br />{company.address.postalCode} {company.address.locality}, concelho de {company.address.municipality}<br /><a class="link link--light small" href={company.mapsHref} target="_blank" rel="noopener" style="font-size:15px">Ver no Google Maps</a></p>
        <p><small>Telemóvel ({company.phoneNote})</small><a href={company.phoneHref}>{company.phone}</a></p>
        <p><small>Email</small><a href={`mailto:${company.email}`}>{company.email}</a></p>
        <p><small>Horário</small>{company.hours.rows.map((h) => <span style="display:block">{h.label}: {h.value}</span>)}</p>
      </div>
      <div>
        <h2>Ligações</h2>
        <ul class="footer__links">
          {links.map((l) => <li><a href={l.href}>{l.nome}</a></li>)}
          {company.crmUrl && <li><a href={`${company.crmUrl}/portal`}>Área de cliente</a></li>}
        </ul>
      </div>
      <div>
        <h2>Seguros</h2>
        <ul class="footer__links">{ramos.map((r) => <li><a href={`/seguros/${r.slug}/`}>{r.label}</a></li>)}</ul>
      </div>
      <div>
        <h2>Ligamos-lhe</h2>
        <p class="footer__intro">Deixe o nome e o telemóvel. Ligamos-lhe no horário do escritório.</p>
        <Formulario tipo="ligamos" id="rodape" compacto />
      </div>
    </div>
    <div class="footer__meio">
      <Logo />
      <div class="redes">
        <span>Siga-nos</span>
        <a href={company.social.instagram} target="_blank" rel="noopener" aria-label="Instagram da ML Seguros"><Icon name="instagram" /></a>
        <a href={company.social.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn da ML Seguros"><Icon name="linkedin" /></a>
        <a href={company.whatsappHref} target="_blank" rel="noopener" aria-label="WhatsApp da ML Seguros"><Icon name="whatsapp" /></a>
      </div>
    </div>
    <div class="footer__legal">
      <p>© {ano} {company.legalName}<br />Mediador de seguros inscrito na ASF com o n.º {company.asf} · NIF {company.nif}</p>
      <ul>
        <li><a href="/politica-de-privacidade/">Informação legal e privacidade</a></li>
        <li><a href="https://www.livroreclamacoes.pt" target="_blank" rel="noopener">Livro de Reclamações</a></li>
        <li><a href="https://www.cimpas.pt" target="_blank" rel="noopener">CIMPAS (resolução de litígios)</a></li>
        <li><a href="/mapa-do-site/">Mapa do site</a></li>
        <li><button class="footer__botao" type="button" data-cookies-abrir>Definições de cookies</button></li>
        <li><a href="/creditos/">Fotografias via Unsplash</a></li>
        <li><a href="https://www.stackd-io.com/" target="_blank" rel="noopener">Desenvolvido por Stackd</a></li>
      </ul>
    </div>
  </div>
</footer>
