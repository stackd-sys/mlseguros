---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Tag from '../components/Tag.astro';
import Icon from '../components/Icon.astro';
import Formulario from '../components/Formulario.astro';
import Avaliacoes from '../components/Avaliacoes.astro';
import { company, insurers } from '../data/site.js';

const depois = [
  { icone: 'phone-call', titulo: 'Ligamos-lhe', texto: 'Para confirmar o que precisa e o que já tem. Se tiver uma apólice atual, pedimos-lhe uma cópia.' },
  { icone: 'files', titulo: 'Pedimos as propostas', texto: `À ${insurers.slice(0, 3).map((i) => i.name).join(', à ')} ou à ${insurers[3].name}, entre outras, com as mesmas coberturas.` },
  { icone: 'scale', titulo: 'Mostramos as diferenças', texto: 'Preço, franquias, rede de prestadores e o que fica de fora. A escolha é sua e não paga nada pela proposta.' },
];
---
<Base
  title="Simulação de seguro sem custo"
  description="Peça uma simulação de seguro automóvel, habitação, saúde, vida ou para a sua empresa. A ML Seguros pede propostas a várias seguradoras e liga-lhe com os valores."
  image="passoPropostas"
  heroImage="passoPropostas"
  proposta="#pedido"
>
  <PageHero titulo="Simulação de seguro na Ericeira" foto="passoPropostas" lead="Escolha o seguro, deixe o seu contacto e diga-nos o que souber. Pedimos propostas a várias seguradoras e ligamos-lhe com os valores." migalhas={[{ nome: 'Simulação' }]} />

  <section class="sec" id="pedido" aria-labelledby="pedido-h">
    <div class="wrap grid-2 grid-2--top">
      <div class="reveal">
        <Tag>Sem custo</Tag>
        <h2 id="pedido-h" style="margin-top:16px">O que acontece depois do pedido</h2>
        <p class="lead" style="margin-top:20px">Se preferir, ligue para o <a href={company.phoneHref}>{company.phone}</a> ou escreva pelo <a href={company.whatsappHref} target="_blank" rel="noopener">WhatsApp</a>.</p>
        <ol class="passos">
          {depois.map((p) => <li class="passo"><span class="ico ico--soft"><Icon name={p.icone} /></span><div><h3>{p.titulo}</h3><p>{p.texto}</p></div></li>)}
        </ol>
        <div style="margin-top:40px;padding-top:32px;border-top:1px solid var(--line)"><Avaliacoes modo="resumo" /></div>
      </div>
      <div class="form-card reveal" data-d="1">
        <h3>Pedir proposta</h3>
        <p>Os campos opcionais ajudam a pedir valores mais certos.</p>
        <Formulario tipo="proposta" id="sim" />
      </div>
    </div>
  </section>
</Base>
