---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Página não encontrada" description="A página que procura não existe.">
  <section class="section section--warm">
    <div class="container" style="text-align:center;max-width:640px">
      <span class="eyebrow">Erro 404</span>
      <h1>Esta página <span class="hl">não existe.</span></h1>
      <p class="lead">Pode ter mudado de endereço com o novo site. Experimente um destes caminhos:</p>
      <div class="hero__ctas" style="justify-content:center">
        <a class="btn" href="/">Página inicial <Icon name="arrow" size={18} /></a>
        <a class="btn btn--outline" href="/simulacao/">Pedir simulação</a>
        <a class="btn btn--outline" href="/contactos/">Contactos</a>
      </div>
    </div>
  </section>
</Base>
