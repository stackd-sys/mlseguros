---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { company, insurers } from '../data/site.js';
const insurerNames = insurers.map((i) => i.name).join(', ').replace(/, ([^,]*)$/, ' e $1');
---
<Base
  title="Sobre Nós"
  description="A ML Seguros é uma mediadora de seguros independente na Ericeira, com mais de 25 anos de experiência com famílias e empresas do concelho de Mafra."
  image="ericeiraHouses"
>
  <PageHero
    title="Sobre a ML Seguros"
    lead={`Mediadora de seguros na Ericeira há mais de ${company.years} anos.`}
    crumbs={[{ label: 'Sobre nós' }]}
  />

  <section class="section">
    <div class="container feature feature--top">
      <div class="prose">
        <p class="lead">Somos uma mediadora de seguros independente, com escritório na {company.address.street}, na Ericeira. A maior parte dos nossos clientes vive ou trabalha no concelho de Mafra.</p>
        <p>Trabalhamos com seguradoras como a {insurerNames}. Para cada pedido, comparamos o que elas oferecem e recomendamos a que faz mais sentido para o cliente.</p>
        <p>Tratamos de seguros de particulares (carro, casa, saúde e vida) e de empresas da zona, da restauração à construção. Quando um cliente tem um sinistro, ajudamos a participar e acompanhamos o processo com a seguradora.</p>
        <h2>Registo</h2>
        <p>A {company.legalName} está inscrita na Autoridade de Supervisão de Seguros e Fundos de Pensões (ASF) com o n.º {company.asf}. Pode confirmar o registo no <a href="https://www.asf.com.pt" target="_blank" rel="noopener">site da ASF</a>. A restante informação legal está na página de <a href="/politica-de-privacidade/">informação legal</a>.</p>
      </div>
      <Photo name="ericeiraHouses" alt="Rua de casas brancas na Ericeira" sizes="(max-width: 860px) 100vw, 540px" />
    </div>
  </section>

  <CtaBand title="Visite-nos na Ericeira" />
</Base>
