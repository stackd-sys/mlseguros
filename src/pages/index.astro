---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { company, insurers, ramosBySegment, generalFaq } from '../data/site.js';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: generalFaq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
const segments = [
  { id: 'particulares', label: 'Particulares', items: ramosBySegment('particulares') },
  { id: 'empresas', label: 'Empresas', items: ramosBySegment('empresas') },
];
---
<Base
  title="ML Seguros | Mediador de Seguros na Ericeira e Mafra"
  description="Mediador de seguros na Ericeira há mais de 25 anos. Seguros automóvel, habitação, saúde, vida e acidentes de trabalho. Comparamos Fidelidade, Allianz, Generali e Ageas."
  schema={[faqSchema]}
>
  <section class="hero">
    <div class="container">
      <div>
        <h1>O descanso de saber que tudo o que construiu está seguro.</h1>
        <p class="lead">Somos uma mediadora de seguros na Ericeira, com mais de {company.years} anos de trabalho. Comparamos propostas de várias seguradoras e, quando há um sinistro, é connosco que fala.</p>
        <div class="actions">
          <a class="btn" href="/seguros-particulares/">Seguros para particulares</a>
          <a class="btn btn--outline" href="/seguros-empresas/">Seguros para empresas</a>
        </div>
        <p class="facts">
          <strong>{company.address.street}, {company.address.locality}</strong><br />
          <a href={company.phoneHref}>{company.phone}</a> · Mediador registado na ASF com o n.º {company.asf}
        </p>
      </div>
      <figure>
        <Photo name="heroAdvisor" alt="Mediador de seguros a cumprimentar um casal sénior" sizes="(max-width: 900px) 100vw, 520px" priority />
      </figure>
    </div>
  </section>

  <section class="insurers" aria-label="Seguradoras">
    <div class="container">
      <p>Trabalhamos com {insurers.map((i, n) => (
        <>{n > 0 && (n === insurers.length - 1 ? ' e ' : ', ')}<a href={i.href} target="_blank" rel="noopener">{i.name}</a></>
      ))}, entre outras.</p>
    </div>
  </section>

  <section class="section" id="seguros">
    <div class="container">
      <div class="section-intro">
        <h2>Seguros</h2>
        <p>Cada seguro tem uma página com as coberturas principais e as perguntas que mais nos fazem.</p>
      </div>
      <div class="tabs" role="tablist" aria-label="Tipo de cliente">
        {segments.map((s, i) => (
          <button role="tab" type="button" id={`tab-${s.id}`} aria-controls={`panel-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{s.label}</button>
        ))}
      </div>
      {segments.map((s, i) => (
        <ul class="ramo-list" role="tabpanel" id={`panel-${s.id}`} aria-labelledby={`tab-${s.id}`} hidden={i !== 0}>
          {s.items.map((r) => (
            <li>
              <h3><a href={`/seguros/${r.slug}/`}>{r.name}</a></h3>
              <p>{r.short}</p>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </section>

  <section class="section section--alt" id="auditoria">
    <div class="container feature">
      <div>
        <h2>Análise gratuita às apólices da sua empresa</h2>
        <p>Envie-nos as apólices que a empresa tem hoje. Vemos se há coberturas em falta ou repetidas, se o seguro de acidentes de trabalho está bem enquadrado e se há condições melhores noutras seguradoras.</p>
        <p>A análise não tem custo e não fica obrigado a mudar.</p>
        <a class="btn" href="/simulacao/?tipo=auditoria-empresas">Pedir análise</a>
      </div>
      <Photo name="advisorCouple" alt="Mediador a apresentar uma proposta a dois clientes" sizes="(max-width: 860px) 100vw, 540px" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-intro">
        <h2>Como trabalhamos</h2>
      </div>
      <ol class="steps">
        <li><h3>Falamos consigo</h3><p>Por telefone, WhatsApp ou no escritório. Vemos que seguros tem e quanto paga.</p></li>
        <li><h3>Pedimos propostas</h3><p>A várias seguradoras, com as mesmas coberturas, para poder comparar.</p></li>
        <li><h3>Escolhe</h3><p>Explicamos as diferenças entre as propostas. A decisão é sua.</p></li>
        <li><h3>Acompanhamos</h3><p>Renovações, alterações e sinistros passam por nós.</p></li>
      </ol>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container feature feature--top">
      <div>
        <h2>Perguntas frequentes</h2>
        <p>Não encontra a resposta? Ligue para o <a class="link" href={company.phoneHref}>{company.phone}</a> ou envie mensagem por <a class="link" href={company.whatsappHref} target="_blank" rel="noopener">WhatsApp</a>.</p>
        <div class="rating">
          <strong>{company.google.rating}</strong>
          <span><span class="stars" aria-hidden="true">★★★★★</span><br />{company.google.count} avaliações no Google · <a class="link" href={company.google.href} target="_blank" rel="noopener">ler</a></span>
        </div>
      </div>
      <Faq items={generalFaq} />
    </div>
  </section>

  <CtaBand />
</Base>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
  const select = (tab: HTMLButtonElement) => {
    tabs.forEach((t) => {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
    });
  };
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(tab));
    tab.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length];
      next.focus();
      select(next);
    });
  });
</script>
