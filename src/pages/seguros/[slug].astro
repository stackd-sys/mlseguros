---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Photo from '../../components/Photo.astro';
import PageHero from '../../components/PageHero.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { company, ramos, ramosBySegment } from '../../data/site.js';

export function getStaticPaths() {
  return ramos.map((ramo) => ({ params: { slug: ramo.slug }, props: { ramo } }));
}
const { ramo } = Astro.props;
const hub = ramo.segment === 'particulares'
  ? { label: 'Particulares', href: '/seguros-particulares/' }
  : { label: 'Empresas', href: '/seguros-empresas/' };
const related = ramosBySegment(ramo.segment).filter((r) => r.slug !== ramo.slug).slice(0, 3);
const url = new URL(Astro.url.pathname, Astro.site).href;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: ramo.name,
    serviceType: ramo.name,
    description: ramo.seoDescription,
    url,
    provider: { '@id': 'https://mlseguros.pt/#agency' },
    areaServed: company.areaServed.map((name) => ({ '@type': 'City', name })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: ramo.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: 'https://mlseguros.pt/' },
      { '@type': 'ListItem', position: 2, name: hub.label, item: new URL(hub.href, Astro.site).href },
      { '@type': 'ListItem', position: 3, name: ramo.name, item: url },
    ],
  },
];
---
<Base title={ramo.seoTitle} description={ramo.seoDescription} image={ramo.image} schema={schema}>
  <PageHero title={ramo.name} lead={ramo.short} crumbs={[hub, { label: ramo.name }]}>
    <div class="actions">
      <a class="btn" href={`/simulacao/?tipo=${ramo.slug}`}>Pedir simulação</a>
      <a class="btn btn--outline" href={company.phoneHref}>Ligar {company.phone}</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="container layout-aside">
      <div class="prose">
        <figure><Photo name={ramo.image} alt="" sizes="(max-width: 960px) 100vw, 760px" /></figure>
        <p class="lead">{ramo.intro}</p>

        <h2>Coberturas principais</h2>
        <dl class="cover-list">
          {ramo.coverages.map(([t, d]) => (
            <div><dt>{t}</dt><dd>{d}</dd></div>
          ))}
        </dl>
        <p class="muted small" style="margin-top:1rem">Coberturas, capitais e exclusões variam entre seguradoras. Antes de contratar, enviamos tudo por escrito.</p>

        <h2>Para quem é</h2>
        <ul class="plain-list">{ramo.audience.map((a) => <li>{a}</li>)}</ul>

        <h2>Perguntas frequentes</h2>
        <Faq items={ramo.faq} />
      </div>

      <aside class="box" aria-label="Pedir proposta">
        <h2>Pedir proposta</h2>
        <p>Pedimos condições à Fidelidade, Allianz, Generali Tranquilidade e Ageas e mostramos-lhe as diferenças.</p>
        <a class="btn btn--block" href={`/simulacao/?tipo=${ramo.slug}`}>Pedir simulação</a>
        <ul>
          <li><a href={company.phoneHref}><Icon name="phone" size={18} /> {company.phone}</a></li>
          <li><a href={company.whatsappHref} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} /> WhatsApp</a></li>
          <li><a href={`mailto:${company.email}?subject=${encodeURIComponent(ramo.name)}`}><Icon name="mail" size={18} /> {company.email}</a></li>
          <li><a href="/sinistros/">Já é cliente? Participar um sinistro</a></li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-intro">
        <h2>Outros seguros para {hub.label.toLowerCase()}</h2>
      </div>
      <ul class="ramo-list">
        {related.map((r) => (
          <li>
            <h3><a href={`/seguros/${r.slug}/`}>{r.name}</a></h3>
            <p>{r.short}</p>
          </li>
        ))}
      </ul>
      <p style="margin-top:1.5rem"><a class="more" href={hub.href}>Ver todos</a></p>
    </div>
  </section>

  <CtaBand title={`Pedir proposta de ${ramo.name.toLowerCase()}`} tipo={ramo.slug} />
</Base>
