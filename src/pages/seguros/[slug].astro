---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import Faq from '../../components/Faq.astro';
import Foto from '../../components/Foto.astro';
import SeccaoProposta from '../../components/SeccaoProposta.astro';
import { company, ramos } from '../../data/site.js';
import { fotos, fotoSrc } from '../../data/fotos.js';

export function getStaticPaths() {
  return ramos.map((ramo) => ({ params: { slug: ramo.slug }, props: { ramo } }));
}
const { ramo } = Astro.props;
const hub = ramo.segment === 'particulares'
  ? { label: 'Particulares', href: '/seguros-particulares/' }
  : { label: 'Empresas', href: '/seguros-empresas/' };
const url = new URL(Astro.url.pathname, Astro.site).href;
const sobre = ramo.label.toLowerCase().startsWith('seguro') ? `o ${ramo.label.toLowerCase()}` : `o seguro de ${ramo.label.toLowerCase()}`;
const ICONES = ['shield-check', 'circle-check', 'umbrella', 'life-buoy', 'badge-check', 'file-check'];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: ramo.label,
    serviceType: ramo.label,
    description: ramo.seoDescription,
    url,
    provider: { '@id': `${Astro.site}#agency` },
    areaServed: company.areaServed.map((name) => ({ '@type': 'City', name })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: ramo.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
];
---
<Base title={ramo.seoTitle} description={ramo.seoDescription} image={ramo.image} schema={schema} proposta="#proposta" heroImage={ramo.image}>
  <PageHero titulo={`${ramo.label} na Ericeira`} foto={ramo.image} lead={ramo.short} migalhas={[{ nome: hub.label, href: hub.href }, { nome: ramo.label }]} />

  <section class="sec" aria-label={ramo.label}>
    <div class="wrap ramo">
      <aside class="lado">
        <nav class="lista-lado" aria-labelledby="lado-h">
          <h2 id="lado-h">Os nossos seguros</h2>
          <ul>
            {ramos.map((r) => <li><a href={`/seguros/${r.slug}/`} aria-current={r.slug === ramo.slug ? 'page' : undefined}>{r.label}<Icon name="arrow-up-right" /></a></li>)}
          </ul>
        </nav>
        <div class="ajuda">
          <img src={fotoSrc('contactos', 800)} alt="" width={fotos.contactos.largura} height={fotos.contactos.altura} loading="lazy" />
          <h2>Dúvidas sobre {sobre}?</h2>
          <p>Ligue-nos ou escreva pelo WhatsApp. Explicamos as coberturas sem compromisso.</p>
          <span class="ico"><Icon name="phone-call" /></span>
          <a class="ajuda__tel" href={company.phoneHref}>{company.phone}</a>
          <a class="ajuda__wa" href={company.whatsappHref} target="_blank" rel="noopener"><Icon name="whatsapp" />Escrever pelo WhatsApp</a>
        </div>
      </aside>

      <div class="conteudo">
        <div class="conteudo__foto reveal"><Foto k={ramo.image2} sizes="(max-width: 1199px) 100vw, 820px" eager /></div>
        <p class="lead reveal">{ramo.intro}</p>

        <h2 id="coberturas" class="reveal">O que o seguro pode cobrir</h2>
        <div class="cobs">
          {ramo.coverages.map(([n, d], i) => (
            <div class="cob reveal"><span class="ico ico--sq"><Icon name={ICONES[i % ICONES.length]} /></span><div><h3>{n}</h3><p>{d}</p></div></div>
          ))}
        </div>

        <h2 class="reveal">Para quem é</h2>
        <div class="par">
          <div class="par__foto reveal"><Foto k={ramo.segment === "particulares" ? "passoConversa" : "passoPropostas"} sizes="(max-width: 767px) 100vw, 400px" class="" /></div>
          <div class="par__texto reveal" data-d="1">
            <span class="ico"><Icon name="users-round" /></span>
            <h3>Quem nos pede este seguro</h3>
            <ul class="par__lista">
              {ramo.audience.map((a) => <li><span class="ico ico--soft"><Icon name="check" /></span>{a}</li>)}
            </ul>
          </div>
        </div>

        <h2 id="perguntas" class="reveal">Perguntas sobre {sobre}</h2>
        <div class="reveal"><Faq perguntas={ramo.faq} /></div>
      </div>
    </div>
  </section>

  <SeccaoProposta
    titulo={`Proposta para ${sobre}`}
    texto={ramo.pista}
    tipo="ramo"
    ramo={ramo.slug}
    formId={ramo.slug}
    formTitulo="Pedir proposta"
  />
</Base>
