---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PhoneField from '../components/PhoneField.astro';
import Consent from '../components/Consent.astro';
import { company } from '../data/site.js';
---
<Base
  title="Contactos"
  description="Contacte a ML Seguros na Ericeira: Rua Dr. Eduardo Burnay, 20-B. Telefone +351 919 400 228, WhatsApp e geral@mlseguros.pt."
  image="ericeiraAerial"
>
  <PageHero
    title="Contactos"
    lead="Pode ligar, escrever ou passar no escritório na Ericeira."
    crumbs={[{ label: 'Contactos' }]}
  />

  <section class="section">
    <div class="container feature feature--top">
      <div>
        <dl class="contact-list">
          <div><dt>Telefone</dt><dd><a href={company.phoneHref}>{company.phone}</a><br /><span class="muted small">{company.phoneNote}</span></dd></div>
          <div><dt>WhatsApp</dt><dd><a href={company.whatsappHref} target="_blank" rel="noopener">{company.phone}</a></dd></div>
          <div><dt>Email</dt><dd><a href={`mailto:${company.email}`}>{company.email}</a></dd></div>
          <div><dt>Morada</dt><dd>{company.address.street}<br />{company.address.postalCode} {company.address.locality}<br /><a class="link" href={company.mapsHref} target="_blank" rel="noopener">Ver no Google Maps</a></dd></div>
        </dl>
      </div>
      <form class="panel form" id="contact-form" novalidate>
        <h2 style="font-size:1.4rem;margin:0">Enviar mensagem</h2>
        <div class="form-row">
          <div class="field"><label for="nome">Nome</label><input id="nome" name="nome" autocomplete="name" required /></div>
          <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" required /></div>
        </div>
        <PhoneField />
        <div class="field"><label for="assunto">Assunto</label>
          <select id="assunto" name="assunto_pedido"><option>Pedido de proposta</option><option>Participar um sinistro</option><option>Alteração a uma apólice</option><option>Outro assunto</option></select>
        </div>
        <div class="field"><label for="mensagem">Mensagem</label><textarea id="mensagem" name="mensagem" required></textarea></div>
        <Consent />
        <div><button class="btn" type="submit">Enviar</button></div>
      </form>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="map" id="map">
        <div style="padding:2rem">
          <p>O mapa é carregado do Google Maps só se carregar no botão.</p>
          <button class="btn btn--outline" type="button" id="load-map">Mostrar mapa</button>
        </div>
      </div>
    </div>
  </section>
</Base>

<script define:vars={{ endpoint: company.formEndpoint, email: company.email, embed: company.mapsEmbed }}>
  window.__form = { endpoint, email, embed };
</script>
<script>
  import { setupForm } from '../scripts/forms';
  const cfg = (window as any).__form;
  setupForm(document.getElementById('contact-form') as HTMLFormElement, { endpoint: cfg.endpoint, email: cfg.email, subject: 'Contacto (site)' });
  document.getElementById('load-map')?.addEventListener('click', () => {
    const map = document.getElementById('map')!;
    map.innerHTML = `<iframe src="${cfg.embed}" title="Mapa: ML Seguros na Ericeira" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>`;
  });
</script>
