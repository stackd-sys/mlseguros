---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Tag from '../components/Tag.astro';
import Icon from '../components/Icon.astro';
import Btn from '../components/Btn.astro';
import Formulario from '../components/Formulario.astro';
import { company } from '../data/site.js';
---
<Base
  title="Contactos da ML Seguros na Ericeira"
  description="Telefone, WhatsApp, email e morada do escritório da ML Seguros na Ericeira. Deixe uma mensagem ou peça que lhe liguemos."
  image="contactos"
  heroImage="contactos"
  proposta="/simulacao/"
>
  <PageHero titulo="Contactos da ML Seguros" foto="contactos" lead={`Ligue, escreva pelo WhatsApp ou passe no escritório da ${company.address.street}, na Ericeira.`} migalhas={[{ nome: 'Contactos' }]} />

  <section class="sec" aria-label="Telefone, email e morada">
    <div class="wrap">
      <div class="info reveal">
        <div class="info__item"><span class="ico"><Icon name="phone-call" /></span><div><h3>Telemóvel</h3><a href={company.phoneHref}>{company.phone}</a><p class="small">{company.phoneNote}</p></div></div>
        <div class="info__item"><span class="ico"><Icon name="mail" /></span><div><h3>Email</h3><a href={`mailto:${company.email}`}>{company.email}</a><p class="small"><a href={company.whatsappHref} target="_blank" rel="noopener">Ou escreva pelo WhatsApp</a></p></div></div>
        <div class="info__item"><span class="ico"><Icon name="map-pin" /></span><div><h3>Escritório</h3><p>{company.address.street}, {company.address.postalCode} {company.address.locality}</p><p class="small"><a href={company.mapsHref} target="_blank" rel="noopener">Ver no Google Maps</a></p></div></div>
      </div>

      <div class="grid-2 grid-2--top" style="margin-top:100px">
        <div class="reveal">
          <Tag>Mensagem</Tag>
          <h2 style="margin-top:16px">Mensagem para a equipa</h2>
          <p class="lead" style="margin-top:20px">Uma dúvida, uma alteração à apólice ou outro assunto. A mensagem chega à equipa e respondemos pelo contacto que deixar.</p>
          <p style="margin-top:14px">Para um sinistro, use a <a href="/sinistros/#participar">participação de sinistro</a>.</p>
          <h3 style="margin-top:40px">Horário do escritório</h3>
          <table class="horario" data-horario>
            <tbody>{company.hours.rows.map((h) => <tr data-dias={h.days}><th scope="row">{h.label}</th><td>{h.value}</td></tr>)}</tbody>
          </table>
          <div class="btns" style="margin-top:32px"><Btn href={company.mapsHref} externo>Ver no Google Maps</Btn></div>
        </div>
        <div class="form-card reveal" data-d="1">
          <h3>Enviar uma mensagem</h3>
          <p>Respondemos no horário do escritório.</p>
          <Formulario tipo="contacto" id="msg" />
        </div>
      </div>
    </div>
  </section>
</Base>
