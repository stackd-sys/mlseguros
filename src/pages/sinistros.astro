---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import { company, insurers } from '../data/site.js';

const steps = [
  ['Segurança primeiro', 'Se houver feridos ou perigo, ligue 112. Sinalize o local.'],
  ['Registe o que aconteceu', 'Tire fotografias dos danos, do local e dos documentos. Anote nomes, contactos e matrículas de testemunhas e terceiros.'],
  ['Ligue-nos', 'Explique o que aconteceu. Dizemos-lhe que documentos juntar e tratamos da participação à seguradora.'],
  ['Acompanhamos o processo', 'Fazemos o seguimento da peritagem, da reparação e da indemnização com a seguradora e vamos dando notícias.'],
];

const docs = [
  { icon: 'car', title: 'Acidente automóvel', items: [
    'Declaração Amigável de Acidente (DAAA), assinada pelos dois condutores',
    'Fotografias dos veículos e do local',
    'Carta de condução, Documento Único e apólice',
    'Auto da polícia, se tiver sido chamada',
    'Participação até 8 dias após o acidente',
  ] },
  { icon: 'home', title: 'Danos em casa', items: [
    'Fotografias dos danos antes de reparar',
    'Descrição da causa (rotura, tempestade, infiltração)',
    'Orçamento de reparação ou faturas',
    'Em caso de furto: participação à PSP ou GNR',
    'Evite deitar fora bens danificados até à peritagem',
  ] },
  { icon: 'hardhat', title: 'Acidente de trabalho', items: [
    'Garanta a assistência médica ao trabalhador',
    'Nome, NIF e data de nascimento do sinistrado',
    'Data, hora, local e descrição do acidente',
    'Testemunhas, se as houver',
    'Contacte-nos logo, porque a participação tem prazos curtos',
  ] },
  { icon: 'heart', title: 'Saúde', items: [
    'Faturas com NIF e descrição dos atos médicos',
    'Relatório médico ou prescrição',
    'Número da apólice ou cartão de beneficiário',
    'Em acidentes: relatório da urgência',
    'Guarde os originais até ao reembolso',
  ] },
];

const faq: [string, string][] = [
  ['Tenho de participar o sinistro diretamente à seguradora?', 'Não. Enquanto seu mediador, tratamos da participação por si e acompanhamos o processo. Em situações de assistência urgente (reboque, canalizador), ligue também para a linha de assistência indicada na sua apólice.'],
  ['Onde encontro o número de assistência 24 horas?', 'Está nas condições particulares da apólice, no cartão de assistência e, no automóvel, no certificado internacional de seguro (antiga carta verde). Se não o encontrar, ligue-nos e indicamos o contacto certo.'],
  ['Quanto tempo demora um processo?', 'Depende do tipo de sinistro e da peritagem. Casos simples resolvem-se em poucas semanas.'],
  ['Não concordo com a decisão da seguradora. O que posso fazer?', 'Falamos com a seguradora para rever o processo. Se não houver acordo, pode recorrer ao provedor do cliente da seguradora, à ASF ou ao CIMPAS, o centro de arbitragem de seguros.'],
];
---
<Base
  title="Participar um Sinistro"
  description="Como participar um sinistro automóvel, habitação, acidente de trabalho ou saúde. Passos, documentos necessários e contactos. A ML Seguros trata da participação por si."
  image="ericeiraBeach"
>
  <PageHero
    title="Participar um sinistro"
    lead="Ligue-nos assim que puder. Dizemos-lhe o que juntar e tratamos da participação à seguradora."
    crumbs={[{ label: 'Sinistros' }]}
  >
    <div class="actions">
      <a class="btn" href={company.phoneHref}>Ligar {company.phone}</a>
      <a class="btn btn--outline" href={company.whatsappHref} target="_blank" rel="noopener">Enviar fotografias por WhatsApp</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="container">
      <p class="notice">Se houver feridos, incêndio ou perigo imediato, ligue primeiro para o <strong>112</strong>.</p>
      <div class="section-intro"><h2>O que fazer</h2></div>
      <ol class="steps">
        {steps.map(([t, d]) => (<li><h3>{t}</h3><p>{d}</p></li>))}
      </ol>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-intro">
        <h2>Documentos a ter à mão</h2>
        <p>Não precisa de ter tudo para nos ligar. Com isto, o processo anda mais depressa.</p>
      </div>
      <div class="doc-grid">
        {docs.map((d) => (
          <div>
            <h3>{d.title}</h3>
            <ul class="plain-list">{d.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container feature feature--top">
      <div>
        <h2>Seguradoras</h2>
        <p>Também pode participar no site da sua seguradora. Nesse caso, avise-nos para acompanharmos o processo.</p>
        <table class="table">
          <thead><tr><th scope="col">Seguradora</th><th scope="col">Site</th></tr></thead>
          <tbody>
            {insurers.map((i) => (
              <tr><td>{i.name}</td><td><a href={i.href} target="_blank" rel="noopener">{i.href.replace('https://www.', '')}</a></td></tr>
            ))}
          </tbody>
        </table>
        <p class="muted small" style="margin-top:1rem">O número de assistência 24 horas está nas condições particulares da apólice e no cartão de assistência.</p>
      </div>
      <div>
        <h2>Perguntas frequentes</h2>
        <Faq items={faq} />
      </div>
    </div>
  </section>
</Base>
