---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Tag from '../components/Tag.astro';
import Icon from '../components/Icon.astro';
import SeccaoFaq from '../components/SeccaoFaq.astro';
import SeccaoProposta from '../components/SeccaoProposta.astro';
import { company } from '../data/site.js';

const passos = [
  ['Segurança primeiro', 'Se houver feridos ou perigo, ligue 112 e sinalize o local.'],
  ['Registe o que aconteceu', 'Fotografias dos danos, do local e dos documentos. Nomes, contactos e matrículas de quem estava.'],
  ['Ligue-nos ou participe aqui', 'Dizemos-lhe que documentos juntar e tratamos da participação à seguradora.'],
  ['Acompanhamos o processo', 'Peritagem, reparação e indemnização: falamos com a seguradora e vamos dando notícias.'],
];

const documentos = [
  { icone: 'car', titulo: 'Acidente de carro', itens: [
    'Declaração Amigável assinada pelos dois condutores',
    'Fotografias dos carros e do local',
    'Carta de condução, Documento Único e apólice',
    'Auto da polícia, se tiver sido chamada',
    'Participação até 8 dias depois do acidente',
  ] },
  { icone: 'house', titulo: 'Danos em casa', itens: [
    'Fotografias dos danos antes de reparar',
    'A causa: rotura, tempestade ou infiltração',
    'Orçamento da reparação ou faturas',
    'Num furto, a participação à PSP ou à GNR',
    'Os bens estragados guardados até à peritagem',
  ] },
  { icone: 'hard-hat', titulo: 'Acidente de trabalho', itens: [
    'Assistência médica ao trabalhador',
    'Nome, NIF e data de nascimento de quem se feriu',
    'Data, hora, local e descrição do acidente',
    'Testemunhas, se as houver',
    'Contacto connosco logo: a participação tem prazos curtos',
  ] },
  { icone: 'heart-pulse', titulo: 'Despesas de saúde', itens: [
    'Faturas com NIF e a descrição dos atos médicos',
    'Relatório médico ou prescrição',
    'Número da apólice ou do cartão',
    'Num acidente, o relatório da urgência',
    'Os originais guardados até ao reembolso',
  ] },
];

const perguntas: [string, string][] = [
  ['Tenho de participar o sinistro à seguradora?', 'Não. Tratamos da participação por si e acompanhamos o processo. Para reboque ou um canalizador urgente, ligue também para a assistência que vem na apólice.'],
  ['Onde está o número da assistência 24 horas?', 'Nas condições particulares da apólice, no cartão de assistência e, no carro, no certificado internacional de seguro. Se não o encontrar, ligue-nos.'],
  ['Quanto tempo demora um processo?', 'Depende do tipo de sinistro e da peritagem. Os casos simples resolvem-se em poucas semanas.'],
  ['Não concordo com a decisão da seguradora. E agora?', 'Pedimos à seguradora que reveja o processo. Sem acordo, pode recorrer ao provedor do cliente da seguradora, à ASF ou ao CIMPAS, o centro de arbitragem de seguros.'],
];
---
<Base
  title="Participar um sinistro"
  description="Como participar um sinistro de carro, casa, trabalho ou saúde: os passos, os documentos e um formulário que chega à equipa da ML Seguros, na Ericeira."
  image="sinistros"
  heroImage="sinistros"
  proposta="#participar"
>
  <PageHero titulo="Participar um sinistro à ML Seguros" foto="sinistros" lead="Ligue-nos assim que puder ou deixe aqui o que aconteceu. Dizemos-lhe o que juntar e tratamos da participação à seguradora." migalhas={[{ nome: 'Sinistros' }]} aviso="Se houver feridos, incêndio ou perigo, ligue primeiro para o 112." />

  <section class="sec" id="passos" aria-labelledby="passos-h">
    <div class="wrap">
      <div class="head head--split reveal">
        <div><Tag>Passo a passo</Tag><h2 id="passos-h">Os passos num sinistro</h2></div>
        <p>Fotografias e documentos também podem seguir pelo <a href={company.whatsappHref} target="_blank" rel="noopener">WhatsApp</a> para o {company.phone}.</p>
      </div>
      <ol class="cartoes-4">
        {passos.map(([n, d], i) => <li class="cartao reveal" data-d={String(i % 4)}><span class="cartao__num">Passo {i + 1}</span><h3>{n}</h3><p>{d}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="sec sec--soft" id="documentos" aria-labelledby="documentos-h">
    <div class="wrap">
      <div class="head head--center reveal">
        <Tag>Documentos</Tag>
        <h2 id="documentos-h">Documentos a ter à mão</h2>
        <p>Não precisa de ter tudo para nos ligar. Com isto, o processo anda mais depressa.</p>
      </div>
      <div class="cartoes-4">
        {documentos.map((d, i) => (
          <div class="cartao reveal" data-d={String(i % 4)}>
            <span class="ico"><Icon name={d.icone} /></span>
            <h3>{d.titulo}</h3>
            <ul>{d.itens.map((it) => <li>{it}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <SeccaoProposta
    id="participar"
    etiqueta="Participação"
    titulo="Conte-nos o que aconteceu"
    texto="Em poucas palavras, o que aconteceu e quando. Ligamos-lhe para tratar do resto. Para um reboque ou um canalizador com urgência, ligue também para a assistência 24 horas da sua apólice."
    tipo="sinistro"
    formId="sin"
    formTitulo="Participar o sinistro"
    foto="sinistros2"
  />

  <SeccaoFaq titulo="Perguntas sobre sinistros" perguntas={perguntas} />
</Base>
