---
import ProductCard from './ProductCard.astro';
import { categories, productsIn, type Product } from '../data/products';
interface Props { title: string; intro?: string; products: Product[]; current: string; image?: string }
const { title, intro, products, current, image } = Astro.props;
const chips = [
  { slug: '', label: 'Tudo' },
  { slug: 'novidades', label: 'Novidades' },
  { slug: 'ultimas-unidades', label: 'Últimas unidades' },
  ...categories.map((c) => ({ slug: c.slug, label: c.plural, soon: productsIn(c.slug).length === 0 })),
];
---
<section class="col-head" class:list={{ 'col-head--image': image }}>
  {image && <img class="col-head__img" src={image} alt="" width="1200" height="800" />}
  <div class="container col-head__inner">
    <h1 class="display col-head__title">{title}</h1>
    {intro && <p class="col-head__intro">{intro}</p>}
  </div>
</section>

<div class="container">
  <div class="toolbar">
    <nav class="chips" aria-label="Categorias">
      {chips.map((c) => (
        <a href={c.slug ? `/loja/${c.slug}/` : '/loja/'} class:list={['chip eyebrow', { 'is-active': c.slug === current }]} aria-current={c.slug === current ? 'page' : undefined}>
          {c.label}{c.soon && <small> · em breve</small>}
        </a>
      ))}
    </nav>
    <div class="toolbar__right">
      <span class="eyebrow toolbar__count">{products.length} {products.length === 1 ? 'produto' : 'produtos'}</span>
      {products.length > 1 && (
        <label class="sort eyebrow">
          <span class="sr-only">Ordenar</span>
          <select data-sort>
            <option value="featured">Destaques</option>
            <option value="price-asc">Preço: menor</option>
            <option value="price-desc">Preço: maior</option>
            <option value="name">Nome A–Z</option>
          </select>
        </label>
      )}
    </div>
  </div>

  {products.length > 0 ? (
    <ul class="grid" data-grid>
      {products.map((p, i) => (
        <li data-price={p.price} data-name={p.name} data-index={i}><ProductCard product={p} eager={i < 4} /></li>
      ))}
    </ul>
  ) : (
    <div class="soon">
      <p class="display soon__title">Em breve.</p>
      <p>Esta categoria está a ser preparada para o próximo drop.</p>
      <div class="soon__actions">
        <a href="/loja/" class="pill">Ver a loja</a>
        <a href="/#novo-drop" class="pill pill--outline">Sê o primeiro a saber</a>
      </div>
    </div>
  )}
</div>

<script>
  const select = document.querySelector<HTMLSelectElement>('[data-sort]');
  const grid = document.querySelector<HTMLElement>('[data-grid]');
  select?.addEventListener('change', () => {
    if (!grid) return;
    const items = [...grid.children] as HTMLElement[];
    const by: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
      featured: (a, b) => +a.dataset.index! - +b.dataset.index!,
      'price-asc': (a, b) => +a.dataset.price! - +b.dataset.price!,
      'price-desc': (a, b) => +b.dataset.price! - +a.dataset.price!,
      name: (a, b) => a.dataset.name!.localeCompare(b.dataset.name!, 'pt'),
    };
    items.sort(by[select.value]).forEach((el) => grid.appendChild(el));
  });
</script>

<style>
  .col-head { padding: clamp(40px, 6vw, 80px) 0 clamp(24px, 3vw, 40px); text-align: center; }
  .col-head--image {
    position: relative; color: #fff;
    min-height: clamp(260px, 38vw, 420px);
    display: grid; align-items: end;
    padding-bottom: clamp(28px, 4vw, 48px);
    margin-bottom: 24px;
    background: #222; overflow: hidden;
  }
  .col-head--image::after { content: ''; position: absolute; inset: 0; background: linear-gradient(transparent 30%, rgba(0,0,0,.55)); }
  .col-head__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
  .col-head__inner { position: relative; z-index: 1; }
  .col-head__title { margin: 0; font-size: clamp(38px, 6vw, 72px); text-transform: uppercase; }
  .col-head__intro { margin: 14px auto 0; max-width: 520px; font-size: 14px; opacity: .85; }

  .toolbar {
    display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap;
    padding: 14px 0; margin-bottom: 32px;
    border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
  }
  .chips { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; }
  .chips::-webkit-scrollbar { display: none; }
  .chip {
    font-size: 10.5px; white-space: nowrap;
    padding: 8px 14px; border-radius: 999px; border: 1px solid var(--line);
    transition: border-color .2s, background .2s;
  }
  .chip small { font-size: inherit; color: var(--ink-soft); text-transform: none; letter-spacing: 0; }
  .chip:hover { border-color: var(--ink); }
  .chip.is-active { background: var(--ink); color: #fff; border-color: var(--ink); }
  .chip.is-active small { color: #ccc; }
  .toolbar__right { display: flex; align-items: center; gap: 18px; margin-left: auto; }
  .toolbar__count { font-size: 10.5px; color: var(--ink-soft); }
  .sort select {
    border: 0; background: transparent; font-size: 11px; letter-spacing: .12em; text-transform: uppercase;
    padding: 6px 4px; cursor: pointer;
  }

  .grid {
    list-style: none; margin: 0; padding: 0 0 clamp(56px, 8vw, 110px);
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 40px 24px;
  }
  @media (max-width: 1000px) { .grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 700px) { .grid { grid-template-columns: repeat(2, 1fr); gap: 28px 12px; } }

  .soon { text-align: center; padding: 40px 0 120px; display: grid; justify-items: center; gap: 6px; }
  .soon__title { font-size: 40px; margin: 0 0 8px; }
  .soon p { margin: 0; color: var(--ink-soft); }
  .soon__actions { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; margin-top: 24px; }
</style>
