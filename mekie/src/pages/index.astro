---
import Base from '../layouts/Base.astro';
import Carousel from '../components/Carousel.astro';
import Img from '../components/Img.astro';
import { products } from '../data/products';
import { site } from '../data/site';

const tiles = [
  { href: '/loja/t-shirts/', image: '/images/products/tshirt-khaki-mushrooms-2.webp', label: 'Ver T-Shirts', alt: 'Rapaz com a t-shirt Cogumelos khaki numa rua com graffiti' },
  { href: '/loja/hoodies-crewnecks/', image: '/images/lookbook/mushrooms-hoodie-yellow.webp', label: 'Ver Hoodies', alt: 'Rapaz com o hoodie Cogumelos amarelo pastel, visto de baixo entre as mãos' },
  { href: '/loja/acessorios/', image: '/images/site/banner-95.webp', label: 'Ver Acessórios', alt: 'Meias Mekie brancas com ténis pretos numa calçada' },
];
const bands = [
  {
    href: '/colecoes/cogumelos/',
    kicker: 'Coleção',
    title: 'Cogumelos',
    images: ['/images/lookbook/mushrooms-duo.webp', '/images/lookbook/mushrooms-black.webp'],
    alts: ['Duas raparigas com as t-shirts Cogumelos preta e khaki', 'Rapariga com a t-shirt Cogumelos preta junto a um lago'],
  },
  {
    href: '/colecoes/esqueleto/',
    kicker: 'Coleção',
    title: 'Esqueleto',
    images: ['/images/products/hoodie-skeleton-2.webp', '/images/site/banner-94.webp'],
    alts: ['Rapaz com o hoodie Esqueleto preto num skate park junto ao mar', 'Rapaz com o hoodie Esqueleto claro numa falésia'],
  },
];
const editorial = [
  { href: '/sobre/', image: '/images/lookbook/mushrooms-sleeve.webp', title: 'Sobre nós', cta: 'Ler mais' },
  { href: site.instagram, image: '/images/site/img-3.webp', title: 'O nosso mundo', cta: 'Seguir no Instagram', external: true },
  { href: '/contactos/', image: '/images/site/banner-93.webp', title: 'Fala connosco', cta: 'Contactos' },
];
/* Um de cada modelo primeiro (novidades à frente), depois as outras cores */
const byNew = [...products].sort((a, b) => Number(b.badge === 'Novo') - Number(a.badge === 'Novo'));
const firsts = byNew.filter((p, i) => byNew.findIndex((o) => o.name === p.name) === i);
const featured = [...firsts, ...byNew.filter((p) => !firsts.includes(p))];

---
<Base overlayHeader popup>
  <section class="hero">
    <Img class="hero__img" src="/images/site/hero.webp" largeW={1600} sizes="100vw" alt="A comunidade Mekie vestida com a coleção, numa floresta" width="1600" height="1067" fetchpriority="high" />
    <div class="hero__shade"></div>
    <div class="hero__content">
      <h1 class="hero__title">Bro, o básico nunca falha.</h1>
      <p class="hero__sub">Caps, bucket hat e hoodies novos já na loja.</p>
      <a href="/loja/novidades/" class="pill pill--light hero__cta">Comprar agora</a>
    </div>
  </section>

  <section class="section browse">
    <div class="container">
      <p class="section-title eyebrow">Novidades</p>
      <Carousel products={featured} label="Novidades" />
      <div class="center"><a href="/loja/" class="pill">Ver tudo</a></div>
    </div>
  </section>

  {bands.map((b, i) => (
    <>
      <a href={b.href} class="band">
        {b.images.map((src, n) => (
          <div class="band__media"><Img src={src} sizes="(max-width: 700px) 100vw, 50vw" alt={b.alts[n]} width="1024" height="1536" loading="lazy" /></div>
        ))}
        <div class="band__overlay">
          <p class="eyebrow">{b.kicker}</p>
          <p class="band__title display">{b.title}</p>
          <span class="pill pill--light">Ver coleção</span>
        </div>
      </a>
      {i === 0 && (
        <section class="tiles section">
          <div class="container tiles__grid">
            {tiles.map((t) => (
              <a href={t.href} class="tile">
                <div class="tile__media"><Img src={t.image} sizes="(max-width: 800px) 78vw, 33vw" alt={t.alt} width="540" height="675" loading="lazy" /></div>
                <span class="pill">{t.label}</span>
              </a>
            ))}
          </div>
        </section>
      )}
    </>
  ))}

  <section class="drop" id="novo-drop">
    <Img class="drop__img" src="/images/site/drop.webp" sizes="100vw" alt="Parede de tijolo com graffiti e o M da Mekie em denim, novelos de lã e um skate" width="1200" height="691" loading="lazy" />
    <div class="drop__shade"></div>
    <div class="drop__content container">
      <p class="eyebrow">Novo drop a caminho</p>
      <h2 class="display drop__title">Consegues<br />esperar?</h2>
      <button type="button" class="pill pill--light" data-popup-open>Sê o primeiro a saber</button>
    </div>
  </section>

  <section class="editorial section">
    <div class="container editorial__grid">
      {editorial.map((e) => (
        <a href={e.href} class="ed" {...(e.external ? { target: '_blank', rel: 'noopener' } : {})}>
          <div class="ed__media"><Img src={e.image} sizes="(max-width: 800px) 78vw, 33vw" alt="" width="540" height="675" loading="lazy" /></div>
          <p class="ed__title eyebrow">{e.title}</p>
          <span class="ed__cta eyebrow link-underline">{e.cta}</span>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    height: clamp(560px, 82vh, 860px);
    overflow: hidden;
    color: #fff;
    background: #1d2318;
  }
  .hero :global(.hero__img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 40%; }
  .hero__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.45) 0%, rgba(0,0,0,.1) 30%, rgba(0,0,0,.15) 55%, rgba(0,0,0,.55) 100%); }
  .hero__content {
    position: absolute; left: 0; right: 0; bottom: clamp(44px, 8vh, 80px);
    display: grid; justify-items: center; text-align: center; gap: 6px;
    padding: 0 var(--gutter);
    animation: heroIn 1.1s var(--ease) both .15s;
  }
  .hero__title {
    margin: 0;
    font-family: var(--font-display); font-weight: 600;
    font-size: clamp(30px, 3.6vw, 48px); line-height: 1.05; letter-spacing: -.01em;
    text-shadow: 0 2px 18px rgba(0,0,0,.25);
    text-wrap: balance;
  }
  .hero__sub { margin: 0; font-size: 14.5px; opacity: .92; }
  .hero__cta { margin-top: 18px; min-height: 46px; padding: 0 32px; }
  @keyframes heroIn { from { opacity: 0; transform: translateY(14px); } }

  .center { display: flex; justify-content: center; margin-top: 44px; }

  .band { position: relative; display: grid; grid-template-columns: 1fr 1fr; color: #fff; overflow: hidden; }
  .band__media { aspect-ratio: 4 / 5; max-height: 92vh; width: 100%; overflow: hidden; }
  .band__media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center 22%; transition: transform 1.2s var(--ease); }
  .band:hover .band__media :global(img) { transform: scale(1.03); }
  .band__overlay {
    position: absolute; inset: 0;
    display: grid; place-content: end center; justify-items: center; gap: 12px;
    padding-bottom: clamp(36px, 6vw, 72px);
    background: linear-gradient(transparent 50%, rgba(0,0,0,.45));
    text-align: center;
  }
  .band__overlay .eyebrow { margin: 0; font-size: 11px; }
  .band__title { margin: 0 0 10px; font-size: clamp(34px, 8.5vw, 128px); text-transform: uppercase; }

  .tiles__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .tile { display: grid; justify-items: center; gap: 18px; }
  .tile__media { width: 100%; aspect-ratio: 3 / 4; overflow: hidden; }
  .tile__media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease); }
  .tile:hover .tile__media :global(img) { transform: scale(1.04); }

  .drop {
    position: relative;
    min-height: clamp(460px, 70vh, 720px);
    display: grid; align-items: center;
    background: #000; color: #fff;
    overflow: hidden;
  }
  .drop :global(.drop__img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .drop__shade { position: absolute; inset: 0; background: rgba(0,0,0,.45); }
  .drop__content { position: relative; display: grid; justify-items: center; text-align: center; gap: 22px; }
  .drop__content .eyebrow { margin: 0; }
  .drop__title { margin: 0; font-size: clamp(44px, 8vw, 104px); text-transform: uppercase; }

  .editorial__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .ed { display: grid; gap: 12px; }
  .ed__media { aspect-ratio: 1 / 1.08; overflow: hidden; }
  .ed__media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease); }
  .ed:hover .ed__media :global(img) { transform: scale(1.04); }
  .ed__title { margin: 14px 0 0; font-size: 13px; }
  .ed__cta { font-size: 10.5px; }

  @media (max-width: 800px) {
    .tiles__grid, .editorial__grid {
      grid-auto-flow: column; grid-template-columns: none; grid-auto-columns: 78%;
      overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
    }
    .tiles__grid::-webkit-scrollbar, .editorial__grid::-webkit-scrollbar { display: none; }
    .tile, .ed { scroll-snap-align: start; }
  }
  @media (max-width: 700px) {
    .hero { height: min(88svh, 720px); }
    .band { grid-template-columns: 1fr; }
    .band__media:nth-child(2) { display: none; }
    .band__media { max-height: none; }
  }
  @media (prefers-reduced-motion: reduce) { .hero__content { animation: none; } }
</style>
