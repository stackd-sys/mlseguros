---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="Sobre nós" description="A Mekie Planet é uma marca de roupa da Ericeira. T-shirts, hoodies, caps e meias com os nossos bordados." image="/images/lookbook/mushrooms-duo.webp">
  <section class="ab-hero">
    <img src="/images/site/drop.webp" alt="" width="1200" height="691" />
    <div class="ab-hero__shade"></div>
    <h1 class="display">Sobre nós</h1>
  </section>

  <section class="section container ab">
    <div class="ab__text reveal">
      <p class="eyebrow">Mekie Planet</p>
      <h2 class="display ab__lead">Bro, o básico nunca falha.</h2>
      <p>A Mekie Planet é uma marca de roupa da Ericeira.</p>
      <p>Fazemos t-shirts, hoodies, caps e meias para usar todos os dias. Os bordados são desenhados por nós: os cogumelos, o esqueleto e o logótipo Mekie na manga.</p>
      <p>Os drops são pequenos e algumas peças têm poucas unidades.</p>
      <div class="ab__actions">
        <a href="/loja/" class="pill">Ver a loja</a>
        <a href={site.instagram} class="pill pill--outline" target="_blank" rel="noopener">Instagram</a>
      </div>
    </div>
    <div class="ab__imgs">
      <img class="reveal" src="/images/lookbook/mushrooms-sleeve-sm.webp" alt="Logótipo Mekie bordado na manga de uma t-shirt khaki" width="540" height="810" loading="lazy" />
      <img class="reveal" src="/images/lookbook/mushrooms-hoodie-yellow-sm.webp" alt="Rapaz com hoodie amarelo Mekie com cogumelos bordados, numa floresta" width="540" height="810" loading="lazy" />
    </div>
  </section>
</Base>

<style>
  .ab-hero { position: relative; height: clamp(320px, 50vw, 560px); display: grid; place-items: center; color: #fff; overflow: hidden; background: #111; }
  .ab-hero img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ab-hero__shade { position: absolute; inset: 0; background: rgba(0,0,0,.45); }
  .ab-hero h1 { position: relative; font-size: clamp(44px, 8vw, 104px); text-transform: uppercase; margin: 0; }
  .ab { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 96px); align-items: center; }
  .ab__lead { font-size: clamp(30px, 3.4vw, 46px); margin: 14px 0 24px; }
  .ab__text > p:not(.eyebrow) { font-size: 16px; line-height: 1.7; color: var(--ink-soft); max-width: 520px; }
  .ab__actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 28px; }
  .ab__imgs { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .ab__imgs img { aspect-ratio: 3/4; object-fit: cover; width: 100%; }
  .ab__imgs img:last-child { margin-top: 48px; }
  @media (max-width: 860px) { .ab { grid-template-columns: 1fr; } }
</style>
